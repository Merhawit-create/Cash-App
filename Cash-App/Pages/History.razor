@*
/// <summary>
/// Page to view and sort the transaction history for a selected account.
/// Users can pick an account, sort by date or amount, and delete a transaction.
/// </summary>
*@
@page "/History"
@using CashApp.domen.Account

@using CashApp.services
@inject IAccountServices Accountservices
<h3>Överföringshistorik</h3>
<!--Displays a message "Inga konton " if no accounts exist, otherwise shows a dropdown list to select an account -->
@if (_accounts.Count == 0)
{
    <p>Inga konton</p>
} 



else
{
    <div class="mb-2">
        <label>Välj konto</label>
        <InputSelect TValue="Guid"
                     class="form-select"
                     id="accountSelect"
                     @bind-Value="SelectedAccountId">
            @foreach (var account in _accounts)
            {
                <option value="@account.Id">@account.Name - Saldo: @account.Balance</option>
            }
        </InputSelect>
    </div>
}



<div class="mb-2">
    <!-- Button to sort the list by date -->
    <button class="btn btn-sm" @onclick="() => SetSort(SortKey.Date)">
        Sortera: Datum @(currentKey == SortKey.Date ? (descending ? "upp" : "ned") : "")
    </button>
    <!-- Button to sort the list by amount -->
    <button class="btn btn-sm" @onclick="() => SetSort(SortKey.Amount)">
        Sortera: Belopp @(currentKey == SortKey.Amount ? (descending ? "upp" : "ned") : "")
    </button>
</div>

<!--Displays a table of all transactions for the selected account, or a message if there are none  -->
@if (!(_selectedAccount?.Transactions?.Any() ?? false)) 
{
    <p>Inga transaktioner ännu.</p> 
}
else
{
    <table class="table table-sm">
        <thead>
        <tr>
            <th>Datum</th>
            <th>Belopp</th>
            <th>Transaktionstyp</th>
            <th>Saldo efter</th>
            <th>Från - Till</th>
            <th></th> <!-- Delete column -->
        </tr>
        </thead>
        <tbody>
        @foreach (var transcaction in SortedTransactions())
        {<tr>                                    
             <td>@transcaction.Date.ToLocalTime().ToString($"yyyy-MM-dd")</td>  
          

                <td>@transcaction.Amount</td>
                <td>@transcaction.TransactionType</td>
                <td>@transcaction.BalanceAfter</td>
                
                <td>
                    
                    @if (transcaction.FromAccountId.HasValue || transcaction.ToAccountId.HasValue)
               
                    {
                        <span>
                            @(transcaction.FromAccountId?.ToString().Substring(0,6) ?? "" ?? "")
                    
                            @(transcaction.FromAccountId.HasValue && transcaction.ToAccountId.HasValue ? " -> " : "")
                            @(transcaction.ToAccountId?.ToString().Substring(0,6) ?? "" ?? "")
                        </span>
                    }
                </td>
                
                
                <td>
                    <button class="btn btn-danger btn-sm"
                            @onclick="() => DeleteTransactionAsync(transcaction)">Ta bort</button> @* ÄNDRING *@
                </td>
        </tr>






            
        
        }
        </tbody>
    </table>
}


@code {
    /// <summary>
    /// Stores the list of accounts, the currently selected account and its ID, and the current sorting settings (key and order).
    /// </summary>
    private List<IBankAccount> _accounts = new();
    private IBankAccount? _selectedAccount;
    private Guid _selectedAccountId;
    //startvärde för sorteringen
    private SortKey currentKey = SortKey.Date;
    private bool descending = true;
    
    /// <summary>
    /// Available sort keys for the table.
    /// </summary>
    private enum SortKey
    { 
        Date,
        Amount
    }
    /// <summary>
    /// Toggle or set sorting by the given key.
    /// </summary>
    private void SetSort(SortKey sortKey)
    { 
        if (currentKey == sortKey)
        {
            descending = !descending;
        }
        else
        {
            currentKey = sortKey;
            descending = true;
        }
    }
  
    /// <summary>
    /// The ID of the chosen account. 
    /// When it changes, the selected account is updated.
    /// </summary>
    public Guid SelectedAccountId
    {
        get => _selectedAccountId;
        set
        { 
            if(_selectedAccountId == value)
                return;
            _selectedAccountId = value;
            _selectedAccount = _accounts.FirstOrDefault(account => account.Id == value);
        }
    }

    /// <summary>
    /// Load accounts and preselect the first one (if any).
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        var accounts = await Accountservices.GetAccounts(); 
      _accounts = accounts ?? new List<IBankAccount>();
    // If there is at least one account, select the first one as the active account
        if (_accounts.Count > 0)
        { 
            _selectedAccountId = _accounts[0].Id;
            _selectedAccount = _accounts[0];
        }
    }
   

    /// <summary>
    /// Return transactions sorted by the chosen key and order.
    /// </summary>
    private IEnumerable<Transaction> SortedTransactions()
    {
        if (_selectedAccount == null)
            return Enumerable.Empty<Transaction>();
        var sortedList = _selectedAccount.Transactions.AsEnumerable();
        sortedList = currentKey switch
        {
            SortKey.Amount => (descending
                ? sortedList.OrderByDescending(t => t.Amount)
                : sortedList.OrderBy(t => t.Amount)), 
                 _ => (descending 
                ? sortedList.OrderByDescending<Transaction, object>(t => t.Date) 
                : sortedList.OrderBy(t => t.Date))
        };
        return sortedList;
    }
    
    /// <summary>
    /// Delete a transaction and refresh the UI.
    /// </summary>
    private async Task DeleteTransactionAsync(Transaction transaction)
    { 
        if (_selectedAccount is null) return;
        await Accountservices.DeleteTransactionAsync(_selectedAccount.Id, transaction.Id); 
        _accounts = await Accountservices.GetAccounts();
        _selectedAccount = _accounts.FirstOrDefault(a => a.Id == _selectedAccountId);
        StateHasChanged(); 
    }

   
}